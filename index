<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>教學分組管理系統 (等寬自動換行版)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f1f1; }
    ::-webkit-scrollbar-thumb { background: #c5c5c5; border-radius: 3px; }

    .sortable-ghost { opacity: 0.3; background: #dbeafe !important; border: 2px dashed #2563eb !important; }
    .print-engine-render { display: none; }

    /* ==========================================
       🖨️ 列印專屬完美排版設定 (強制等寬與自動換行核心)
       ========================================== */
    @media print {
      body { background-color: white !important; color: black !important; }
      .screen-ui { display: none !important; }
      .print-engine-render { display: block !important; width: 100% !important; }
      
      /* 分頁斷頁設定 */
      .print-page-section { break-after: page !important; page-break-after: always !important; }
      .print-page-section:last-child { break-after: auto !important; page-break-after: auto !important; }
      .print-header { border-bottom: 2px solid #222; padding-bottom: 8px; margin-bottom: 16px; }
      
      /* 🌟 核心修正 1：強制等寬排版，運用 minmax(0, 1fr) 杜絕卡片被長文字撐大 */
      .groups-print-grid { 
        display: grid !important; 
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important; 
        gap: 12px !important; 
        width: 100% !important;
      }
      
      /* 確保每組邊框與寬度鎖定 */
      .group-card { 
        border: 1px solid #64748b !important; 
        break-inside: avoid; 
        box-shadow: none !important; 
        border-radius: 4px !important; 
        width: 100% !important;
        box-sizing: border-box !important;
      }

      /* 🌟 核心修正 2：備註區文字自動換行防護 */
      .print-note-box {
        white-space: pre-wrap !important;
        word-break: break-word !important;
        overflow-wrap: break-word !important;
        display: block !important; /* 改為 block 確保多行文字正常向下延展 */
        width: 100% !important;
        box-sizing: border-box !important;
        line-height: 1.3 !important;
      }

      .print-single-column { 
        display: flex !important; 
        flex-direction: column !important; 
        align-items: stretch !important; 
        gap: 2px !important; 
        width: 100% !important;
      }
      
      /* 學生項目也套用斷字換行，防止特殊長名字破版 */
      .print-student-item { 
        border-bottom: 1px solid #cbd5e1 !important; 
        padding: 4px 2px !important; 
        word-break: break-word !important;
        overflow-wrap: break-word !important;
        white-space: normal !important;
        line-height: 1.25 !important;
      }
      
      .tag-print { 
        border: 1px solid #99f6e4 !important; 
        padding: 1px 6px !important; 
        font-size: 11px; 
        display: inline-block;
        word-break: break-word;
      }
      input { border: none !important; background: transparent !important; }
    }
  </style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800">

  <div id="app">
    
    <div class="screen-ui container mx-auto p-4 max-w-7xl">
      <input type="file" ref="fileInput" @change="importJSON" accept=".json" class="hidden" />

      <header class="flex flex-wrap justify-between items-center gap-4 mb-6 bg-white p-4 rounded-xl shadow-sm border border-slate-200">
        <div class="flex items-center gap-3">
          <div class="bg-indigo-600 text-white p-2.5 rounded-lg"><i class="fa-solid fa-layer-group text-xl"></i></div>
          <div>
            <h1 class="text-xl font-bold">教學分組管理系統 <span class="text-xs bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded ml-1">v7.5 完美排版版</span></h1>
            <p class="text-xs text-slate-500">強制報表等寬顯示、備註超長自動換行、全域配置一鍵建立</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button @click="triggerImport" class="bg-slate-100 hover:bg-slate-200 text-xs font-bold px-3 py-2 rounded-lg border border-slate-300 transition flex items-center gap-1">
            <i class="fa-solid fa-file-import text-indigo-600"></i> 匯入
          </button>
          <button @click="exportJSON" class="bg-slate-100 hover:bg-slate-200 text-xs font-bold px-3 py-2 rounded-lg border border-slate-300 transition flex items-center gap-1">
            <i class="fa-solid fa-file-export text-emerald-600"></i> 匯出
          </button>
          <button @click="openPrintSetup" class="bg-indigo-700 hover:bg-indigo-800 text-white px-5 py-2 rounded-lg text-sm font-bold shadow-md ml-2 transition flex items-center gap-1.5">
            <i class="fa-solid fa-print"></i> 輸出報表
          </button>
        </div>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        
        <aside class="lg:col-span-1 space-y-4">
          <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
            <h2 class="text-xs font-black mb-3 border-b pb-2 flex items-center gap-2 text-indigo-700 uppercase">
              <i class="fa-solid fa-database"></i> 基礎資料建檔源
            </h2>
            <div class="space-y-3">
              
              <div>
                <label class="block text-[10px] font-bold text-rose-600 mb-1 flex justify-between">
                  <span>🏷️ 預設組別名稱清單</span>
                  <span class="text-slate-400 font-normal">每行一組</span>
                </label>
                <textarea v-model="rawGroupNames" rows="3" class="w-full p-2 text-xs border border-rose-200 rounded-lg outline-none focus:ring-2 focus:ring-rose-500 bg-rose-50/10" placeholder="第一組&#10;第二組&#10;第三組..."></textarea>
              </div>

              <div>
                <label class="block text-[10px] font-bold text-slate-500 mb-1">👨‍🎓 學生總名單</label>
                <textarea v-model="rawStudents" rows="5" class="w-full p-2 text-xs border rounded-lg outline-none focus:ring-2 focus:ring-indigo-500" placeholder="每行一位學生"></textarea>
              </div>

              <div>
                <label class="block text-[10px] font-bold text-slate-500 mb-1">👨‍🏫 教師名單</label>
                <textarea v-model="rawTeachers" rows="2" class="w-full p-2 text-xs border rounded-lg outline-none focus:ring-2 focus:ring-emerald-500" placeholder="正式/協同老師"></textarea>
              </div>

              <div>
                <label class="block text-[10px] font-bold text-slate-500 mb-1">🧑‍🤝‍🧑 助理 / 志工名單</label>
                <textarea v-model="rawAssistants" rows="2" class="w-full p-2 text-xs border rounded-lg outline-none focus:ring-2 focus:ring-amber-500" placeholder="特教助理員/陪讀者"></textarea>
              </div>

              <button @click="applyToCurrentTab" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-2 rounded-lg text-xs font-bold transition shadow-sm mt-2 flex items-center justify-center gap-1">
                <i class="fa-solid fa-wand-magic-sparkles"></i> 依清單自動開組並載入
              </button>
              <p class="text-[9px] text-slate-400 text-center">💡 系統會自動依上方組名清單行數建立組別</p>
            </div>
          </div>
        </aside>

        <main class="lg:col-span-3">
          
          <div id="tab-list" class="flex items-center gap-1 overflow-x-auto mb-4 border-b border-slate-300 min-h-[45px]">
            <div v-for="tab in tabs" :key="tab.id" :data-id="tab.id" @click="activeTabId = tab.id"
              :class="['group px-4 py-2 rounded-t-lg text-sm font-medium cursor-pointer transition flex items-center gap-2 border-t border-x shrink-0 select-none', activeTabId === tab.id ? 'bg-white text-indigo-600 border-slate-200 shadow-sm' : 'bg-slate-200/50 text-slate-500 hover:bg-slate-200']">
              <span v-if="!tab.isEditing" @dblclick="tab.isEditing = true">{{ tab.name }}</span>
              <input v-else v-model="tab.name" @blur="tab.isEditing = false" @keyup.enter="tab.isEditing = false" v-focus class="border-b border-indigo-400 px-1 text-xs w-24 outline-none">
              <i class="fa-solid fa-grip-vertical text-[10px] text-slate-300 opacity-0 group-hover:opacity-100 cursor-move" title="拖拉排序分頁"></i>
              <button v-if="tabs.length > 1" @click.stop="deleteTab(tab.id)" class="hover:text-red-500 text-xs ml-1">&times;</button>
            </div>
            <button @click="addTab" class="bg-white/50 hover:bg-white px-3 py-2 rounded-t-lg text-sm border border-dashed border-slate-300"><i class="fa-solid fa-plus"></i></button>
          </div>

          <div v-if="currentTab" class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
            
            <div class="flex flex-wrap justify-between items-center gap-4 mb-6 bg-slate-50 p-3 rounded-lg">
              <div class="flex items-center gap-3">
                <span class="text-xs font-bold text-slate-600">目前組數：</span>
                <input type="number" v-model.number="currentTab.targetGroupCount" @change="updateGroupCount" min="1" class="w-12 p-1 border rounded text-center text-xs bg-white">
                <button @click="duplicateCurrentTab" class="text-xs font-bold text-indigo-600 hover:underline flex items-center gap-1">
                  <i class="fa-solid fa-copy"></i> 複製此頁
                </button>
              </div>
              <div class="flex gap-2">
                <button @click="randomizeMembers('students')" class="bg-indigo-500 hover:bg-indigo-600 text-white px-2.5 py-1.5 rounded text-[10px] font-bold transition">隨機學生</button>
                <button @click="randomizeMembers('teachers')" class="bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1.5 rounded text-[10px] font-bold transition">隨機教師</button>
                <button @click="randomizeMembers('assistants')" class="bg-amber-600 hover:bg-amber-700 text-white px-2.5 py-1.5 rounded text-[10px] font-bold transition">隨機助理</button>
                <button @click="resetTabAllocation" class="text-red-500 text-[10px] px-2 border border-red-200 hover:bg-red-50 rounded transition">清空重置</button>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-3 mb-6">
              <div class="bg-indigo-50/50 p-2 rounded-lg border border-indigo-100">
                <h3 class="text-[10px] font-black text-indigo-700 mb-1 uppercase">待分配學生 ({{ currentTab.unassignedStudents.length }})</h3>
                <div class="flex flex-wrap gap-1 min-h-[40px] drop-zone-student" data-type="pool">
                  <div v-for="s in currentTab.unassignedStudents" :key="s" :data-name="s" class="bg-white border border-indigo-200 text-indigo-700 px-2 py-0.5 rounded text-[10px] cursor-move shadow-sm select-none">{{ s }}</div>
                </div>
              </div>
              <div class="bg-emerald-50/50 p-2 rounded-lg border border-emerald-100">
                <h3 class="text-[10px] font-black text-emerald-700 mb-1 uppercase">待分配教師 ({{ currentTab.unassignedTeachers.length }})</h3>
                <div class="flex flex-wrap gap-1 min-h-[40px] drop-zone-teacher" data-type="pool">
                  <div v-for="t in currentTab.unassignedTeachers" :key="t" :data-name="t" class="bg-white border border-emerald-200 text-emerald-700 px-2 py-0.5 rounded text-[10px] cursor-move shadow-sm select-none">{{ t }}</div>
                </div>
              </div>
              <div class="bg-amber-50/50 p-2 rounded-lg border border-amber-100">
                <h3 class="text-[10px] font-black text-amber-700 mb-1 uppercase">待分配助理 ({{ currentTab.unassignedAssistants.length }})</h3>
                <div class="flex flex-wrap gap-1 min-h-[40px] drop-zone-assistant" data-type="pool">
                  <div v-for="a in currentTab.unassignedAssistants" :key="a" :data-name="a" class="bg-white border border-amber-200 text-amber-700 px-2 py-0.5 rounded text-[10px] cursor-move shadow-sm select-none">{{ a }}</div>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              <div v-for="(group, gIdx) in currentTab.groups" :key="group.id" class="border border-slate-200 rounded-xl flex flex-col bg-white overflow-hidden transition">
                
                <div class="bg-slate-100 px-3 py-2 border-b flex items-center gap-2">
                  <span class="bg-slate-700 text-white text-[9px] font-black w-4 h-4 rounded-full flex items-center justify-center shrink-0">{{ gIdx+1 }}</span>
                  <input v-model="group.name" placeholder="輸入組名..." class="bg-transparent font-bold text-xs outline-none w-full text-indigo-950 focus:bg-white px-1 rounded transition border border-transparent focus:border-slate-300">
                </div>

                <div class="bg-indigo-50/20 px-3 py-1 border-b border-slate-150 flex items-center">
                  <input v-model="group.note" placeholder="組別附註說明 (文字過長列印會自動換行)..." class="bg-transparent text-[10px] text-slate-600 w-full outline-none">
                </div>

                <div class="p-2.5 space-y-3 flex-1 flex flex-col">
                  <div>
                    <h4 class="text-[9px] font-black text-emerald-700 mb-1">👨‍🏫 教師</h4>
                    <div class="flex flex-wrap gap-1 min-h-[24px] p-1 bg-emerald-50/10 border border-dashed border-emerald-200 rounded drop-zone-teacher" :data-group-idx="gIdx">
                      <div v-for="(t, tIdx) in group.teachers" :key="t" :data-name="t" class="bg-emerald-600 text-white px-2 py-0.5 rounded text-[10px] flex items-center gap-1 select-none">
                        {{ t }} <i class="fa-solid fa-xmark text-[8px] cursor-pointer opacity-70 hover:opacity-100" @click="removeMember(gIdx, 'teachers', tIdx)"></i>
                      </div>
                    </div>
                  </div>
                  <div>
                    <h4 class="text-[9px] font-black text-amber-700 mb-1">🧑‍🤝‍🧑 助理</h4>
                    <div class="flex flex-wrap gap-1 min-h-[24px] p-1 bg-amber-50/10 border border-dashed border-amber-200 rounded drop-zone-assistant" :data-group-idx="gIdx">
                      <div v-for="(a, aIdx) in group.assistants" :key="a" :data-name="a" class="bg-amber-600 text-white px-2 py-0.5 rounded text-[10px] flex items-center gap-1 select-none">
                        {{ a }} <i class="fa-solid fa-xmark text-[8px] cursor-pointer opacity-70 hover:opacity-100" @click="removeMember(gIdx, 'assistants', aIdx)"></i>
                      </div>
                    </div>
                  </div>
                  <div class="flex-1 flex flex-col">
                    <h4 class="text-[9px] font-black text-indigo-700 mb-1">👨‍🎓 學生名單</h4>
                    <div class="flex flex-wrap gap-1 min-h-[50px] p-1 bg-indigo-50/10 border border-dashed border-indigo-200 rounded flex-1 content-start drop-zone-student" :data-group-idx="gIdx">
                      <div v-for="(s, sIdx) in group.students" :key="s" :data-name="s" class="bg-indigo-600 text-white px-2 py-1 rounded text-[10px] flex items-center justify-between gap-1 w-full sm:w-auto shadow-2xs select-none">
                        <span>{{ s }}</span> <i class="fa-solid fa-xmark text-[8px] cursor-pointer opacity-70 hover:opacity-100" @click="removeMember(gIdx, 'students', sIdx)"></i>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>

    <div v-if="printDialog.show" class="screen-ui fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4">
      <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 animate-in fade-in zoom-in-95 duration-150">
        <h3 class="text-sm font-bold mb-4 flex items-center gap-2 text-indigo-950">
          <i class="fa-solid fa-print text-indigo-600"></i> 自訂列印格式輸出
        </h3>
        <div class="space-y-4">
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="text-[10px] font-bold text-slate-500">選擇列印分頁</label>
              <button @click="toggleSelectAllTabs" class="text-[10px] text-indigo-600 hover:underline">全選/全不選</button>
            </div>
            <div class="max-h-32 overflow-y-auto border rounded divide-y divide-slate-100">
              <label v-for="tab in tabs" :key="tab.id" class="flex items-center gap-2 p-2 hover:bg-slate-50 cursor-pointer text-xs">
                <input type="checkbox" :value="tab.id" v-model="printDialog.selectedTabIds" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"> 
                <span class="font-medium text-slate-800">{{ tab.name }}</span>
              </label>
            </div>
          </div>
          <div>
            <label class="text-[10px] font-bold text-slate-500 block mb-1">學生名字字體大小 ({{ printDialog.fontSize }}px)</label>
            <input type="range" v-model="printDialog.fontSize" min="12" max="24" class="w-full h-2 bg-slate-200 rounded-lg accent-indigo-600 cursor-pointer">
            <div class="flex justify-between text-[9px] text-slate-400 mt-1"><span>標準 12px</span><span>極限大字 24px</span></div>
          </div>
        </div>
        <div class="flex gap-2 mt-6 pt-2 border-t">
          <button @click="printDialog.show = false" class="flex-1 bg-slate-100 hover:bg-slate-200 py-2 rounded text-xs font-bold text-slate-600 transition">取消</button>
          <button @click="executePrint" :disabled="!printDialog.selectedTabIds.length" class="flex-1 bg-indigo-600 hover:bg-indigo-700 disabled:bg-slate-300 text-white py-2 rounded text-xs font-bold shadow-sm transition">確定輸出</button>
        </div>
      </div>
    </div>

    <div class="print-engine-render">
      <div v-for="tab in printEngineTabs" :key="tab.id" class="print-page-section">
        
        <div class="print-header text-center flex flex-col">
          <h1 class="text-2xl font-black">課程：{{ tab.name }}</h1>
          <p class="text-[10px] text-slate-400 mt-1">產出時間：{{ printDateStr }}</p>
        </div>

        <div class="groups-print-grid">
          <div v-for="(group, gIdx) in tab.groups" :key="group.id" class="group-card flex flex-col bg-white">
            
            <div class="bg-slate-100 px-3 py-1.5 border-b border-slate-200">
              <div class="font-bold text-xs text-slate-900">{{ group.name }}</div>
              <div class="text-[10px] font-bold text-slate-500 mt-0.5">人數：{{ group.students.length }}人</div>
            </div>

            <div class="bg-amber-50/30 px-3 py-1.5 border-b border-slate-150 text-[10px] text-slate-700 print-note-box">
              {{ group.note || '' }}
            </div>

            <div class="p-2.5 space-y-2 flex-1 flex flex-col">
              <div v-if="group.teachers.length">
                <div class="text-[9px] font-bold text-emerald-800 mb-0.5">教師</div>
                <div class="flex flex-wrap gap-1">
                  <span v-for="t in group.teachers" :key="t" class="tag-print border border-emerald-200 text-emerald-900 font-medium">{{ t }}</span>
                </div>
              </div>
              <div v-if="group.assistants.length">
                <div class="text-[9px] font-bold text-amber-800 mb-0.5">助理</div>
                <div class="flex flex-wrap gap-1">
                  <span v-for="a in group.assistants" :key="a" class="tag-print border border-amber-200 text-amber-900 font-medium">{{ a }}</span>
                </div>
              </div>
              <div class="flex-1 flex flex-col mt-0.5">
                <div class="text-[9px] font-bold text-indigo-800 mb-0.5 border-b pb-0.5">學生名單</div>
                <div class="print-single-column">
                  <div v-for="(s, sIdx) in getSortedStudents(group.students)" :key="s" class="print-student-item font-medium text-slate-950" :style="{ fontSize: printDialog.fontSize + 'px' }">
                    {{ sIdx + 1 }}. {{ s }}
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>

      </div>
    </div>

  </div>

  <script>
    const { createApp, ref, computed, nextTick, watch } = Vue;

    createApp({
      directives: { focus: { mounted(el) { el.focus(); } } },
      setup() {
        const rawGroupNames = ref("第一車隊\n第二車隊\n第三車隊\n第四車隊\n第五車隊\n第六車隊");
        const rawStudents = ref("王大明\n陳小華\n林美美\n張小強\n李大仁\n黃彩色\n趙雲\n關羽\n張飛\n周杰倫\n蔡依林\n林俊傑");
        const rawTeachers = ref("陳老師\n林老師");
        const rawAssistants = ref("李助理\n張志工");
        
        const tabs = ref([]);
        const activeTabId = ref(null);
        const fileInput = ref(null);
        const printDialog = ref({ show: false, selectedTabIds: [], fontSize: 14 });

        const currentTab = computed(() => tabs.value.find(t => t.id === activeTabId.value));
        const printEngineTabs = computed(() => tabs.value.filter(t => printDialog.value.selectedTabIds.includes(t.id)));
        const printDateStr = computed(() => new Date().toLocaleString());

        const getSortedStudents = (students) => [...students].sort((a, b) => a.localeCompare(b, 'zh-TW'));

        const initSortable = () => {
          nextTick(() => {
            const tabEl = document.getElementById('tab-list');
            if (tabEl) Sortable.create(tabEl, { animation: 150, onEnd: (evt) => {
              const moved = tabs.value.splice(evt.oldIndex, 1)[0];
              tabs.value.splice(evt.newIndex, 0, moved);
            }});

            const zones = [
              { selector: '.drop-zone-student', key: 'students', unKey: 'unassignedStudents' },
              { selector: '.drop-zone-teacher', key: 'teachers', unKey: 'unassignedTeachers' },
              { selector: '.drop-zone-assistant', key: 'assistants', unKey: 'unassignedAssistants' }
            ];

            zones.forEach(zone => {
              document.querySelectorAll(zone.selector).forEach(el => {
                Sortable.create(el, { group: zone.key, animation: 150, onEnd: (evt) => {
                  const fromIdx = evt.from.dataset.groupIdx, toIdx = evt.to.dataset.groupIdx;
                  const fromPool = evt.from.dataset.type === 'pool', toPool = evt.to.dataset.type === 'pool';
                  const name = evt.item.dataset.name;

                  if(fromPool) currentTab.value[zone.unKey].splice(evt.oldIndex, 1);
                  else currentTab.value.groups[fromIdx][zone.key].splice(evt.oldIndex, 1);

                  if(toPool) currentTab.value[zone.unKey].splice(evt.newIndex, 0, name);
                  else currentTab.value.groups[toIdx][zone.key].splice(evt.newIndex, 0, name);
                }});
              });
            });
          });
        };

        const addTab = () => {
          const id = Date.now();
          const customNames = rawGroupNames.value.split('\n').map(s => s.trim()).filter(s => s);
          const initialCount = customNames.length > 0 ? customNames.length : 6;

          tabs.value.push({
            id, 
            name: `教學配置 ${tabs.value.length+1}`, 
            isEditing: false, 
            targetGroupCount: initialCount,
            groups: Array.from({length: initialCount}, (_, i) => ({ 
              id: Date.now() + Math.random(), 
              name: customNames[i] || `第 ${i+1} 組`, 
              note: '', 
              students: [], 
              teachers: [], 
              assistants: [] 
            })),
            unassignedStudents: [], 
            unassignedTeachers: [], 
            unassignedAssistants: []
          });
          activeTabId.value = id;
        };

        const applyToCurrentTab = () => {
          if(!currentTab.value) return;
          const customNames = rawGroupNames.value.split('\n').map(s => s.trim()).filter(s => s);
          currentTab.value.unassignedStudents = rawStudents.value.split('\n').map(s => s.trim()).filter(s => s);
          currentTab.value.unassignedTeachers = rawTeachers.value.split('\n').map(s => s.trim()).filter(s => s);
          currentTab.value.unassignedAssistants = rawAssistants.value.split('\n').map(s => s.trim()).filter(s => s);

          const targetCount = customNames.length > 0 ? customNames.length : currentTab.value.targetGroupCount;
          currentTab.value.targetGroupCount = targetCount;

          currentTab.value.groups = Array.from({length: targetCount}, (_, i) => ({
            id: Date.now() + Math.random(),
            name: customNames[i] || `第 ${i+1} 組`,
            note: '',
            students: [],
            teachers: [],
            assistants: []
          }));
        };

        const randomizeMembers = (type) => {
          const tab = currentTab.value;
          const unKey = type === 'students' ? 'unassignedStudents' : type === 'teachers' ? 'unassignedTeachers' : 'unassignedAssistants';
          if(!tab[unKey].length) return;
          const shuffled = [...tab[unKey]].sort(() => Math.random() - 0.5);
          shuffled.forEach((m, i) => tab.groups[i % tab.groups.length][type].push(m));
          tab[unKey] = [];
        };

        const removeMember = (gIdx, key, mIdx) => {
          const tab = currentTab.value;
          const unKey = key === 'students' ? 'unassignedStudents' : key === 'teachers' ? 'unassignedTeachers' : 'unassignedAssistants';
          tab[unKey].push(tab.groups[gIdx][key].splice(mIdx, 1)[0]);
        };

        const updateGroupCount = () => {
          const tab = currentTab.value;
          const customNames = rawGroupNames.value.split('\n').map(s => s.trim()).filter(s => s);
          const diff = tab.targetGroupCount - tab.groups.length;
          
          if (diff > 0) {
            for (let i = 0; i < diff; i++) {
              const newIdx = tab.groups.length;
              tab.groups.push({ 
                id: Date.now() + Math.random(), 
                name: customNames[newIdx] || `第 ${newIdx + 1} 組`, 
                note: '', 
                students: [], 
                teachers: [], 
                assistants: [] 
              });
            }
          } else if (diff < 0) {
            tab.groups.splice(tab.targetGroupCount).forEach(g => {
              tab.unassignedStudents.push(...g.students); 
              tab.unassignedTeachers.push(...g.teachers); 
              tab.unassignedAssistants.push(...g.assistants);
            });
          }
        };

        const exportJSON = () => {
          const data = JSON.stringify({ 
            tabs: tabs.value, 
            rawGroupNames: rawGroupNames.value, 
            rawStudents: rawStudents.value, 
            rawTeachers: rawTeachers.value, 
            rawAssistants: rawAssistants.value 
          }, null, 2);
          const a = document.createElement('a'); 
          a.href = URL.createObjectURL(new Blob([data], {type:'application/json'})); 
          a.download = `分組配置完整備份_${new Date().toISOString().slice(0,10)}.json`; 
          a.click();
        };

        const triggerImport = () => fileInput.value.click();
        
        const importJSON = (e) => {
          const reader = new FileReader();
          reader.onload = (evt) => {
            try {
              const data = JSON.parse(evt.target.result);
              tabs.value = data.tabs; 
              if (data.rawGroupNames !== undefined) rawGroupNames.value = data.rawGroupNames;
              rawStudents.value = data.rawStudents || ""; 
              rawTeachers.value = data.rawTeachers || ""; 
              rawAssistants.value = data.rawAssistants || "";
              activeTabId.value = data.tabs[0]?.id;
            } catch(err) {
              alert("讀取檔案失敗！");
            }
            e.target.value = '';
          };
          reader.readAsText(e.target.files[0]);
        };

        const openPrintSetup = () => { printDialog.value.selectedTabIds = [activeTabId.value]; printDialog.value.show = true; };
        const toggleSelectAllTabs = () => printDialog.value.selectedTabIds = printDialog.value.selectedTabIds.length === tabs.value.length ? [] : tabs.value.map(t=>t.id);
        const executePrint = () => { setTimeout(() => { window.print(); printDialog.value.show = false; }, 100); };
        
        const duplicateCurrentTab = () => {
          const copy = JSON.parse(JSON.stringify(currentTab.value));
          copy.id = Date.now(); copy.name += ' (複本)';
          copy.groups.forEach(g => g.id = Date.now() + Math.random());
          tabs.value.push(copy); activeTabId.value = copy.id;
        };

        const resetTabAllocation = () => {
          currentTab.value.groups.forEach(g => {
            currentTab.value.unassignedStudents.push(...g.students); 
            currentTab.value.unassignedTeachers.push(...g.teachers); 
            currentTab.value.unassignedAssistants.push(...g.assistants);
            g.students = []; g.teachers = []; g.assistants = [];
          });
        };

        const deleteTab = (id) => { if(confirm('確定要刪除這個分組設定頁嗎？')) { tabs.value = tabs.value.filter(t=>t.id!==id); activeTabId.value = tabs.value[0]?.id; } };

        watch([activeTabId, () => currentTab.value?.groups.length], () => initSortable(), { deep: true });
        
        addTab(); 
        applyToCurrentTab();

        return {
          rawGroupNames, rawStudents, rawTeachers, rawAssistants, tabs, activeTabId, currentTab, fileInput, printDialog, printEngineTabs, printDateStr,
          getSortedStudents, addTab, deleteTab, duplicateCurrentTab, applyToCurrentTab, updateGroupCount, removeMember, randomizeMembers, 
          resetTabAllocation, exportJSON, triggerImport, importJSON, openPrintSetup, toggleSelectAllTabs, executePrint
        };
      }
    }).mount('#app');
  </script>
</body>
</html>
